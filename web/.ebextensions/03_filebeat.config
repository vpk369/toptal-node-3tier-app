files:
  "/etc/filebeat/filebeat.yml":
    mode: "000755"
    owner: root
    group: root
    content: |
      filebeat.prospectors:
      - input_type: log
        paths:
          - /var/app/current/logs/*.log
        json.message_key: event
        json.keys_under_root: true
        json.overwrite_keys: true
      output.elasticsearch:
        hosts: ["%ELK_STACK_IP%:9200"]

commands:
  1_command:
    command: "curl -L -O https://artifacts.elastic.co/downloads/beats/filebeat/filebeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  2_command:
    command: "sudo dpkg -i filebeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  3_command:
    command: "systemctl start filebeat; systemctl enable filebeat"
  # 4_command:
  #   command: "filebeat setup --index-management --modules system,mysql -E output.logstash.enabled=false -E 'output.elasticsearch.hosts=[\"%ELK_STACK_IP%:9200\"]'"

