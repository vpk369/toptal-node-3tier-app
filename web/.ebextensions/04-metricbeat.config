# see grep -v '^\s*#' /etc/metricbeat/metricbeat.yml | grep -v -e '^$'
commands:
  1_command:
    command: "curl -L -O https://artifacts.elastic.co/downloads/beats/metricbeat/metricbeat-7.8.0-x86_64.rpm"
    cwd: /home/ec2-user
  2_command:
    command: "rpm -ivh --replacepkgs  metricbeat-7.8.0-x86_64.rpm"
    cwd: /home/ec2-user
  3_command:
    command: "sed -i 's/localhost/%ELK_STACK_IP%/g' /etc/metricbeat/metricbeat.yml; metricbeat modules enable apache nginx system;  /etc/init.d/metricbeat start"
  # 4_command:
  #   command: "metricbeat setup --dashboards -E setup.kibana.host=%ELK_STACK_IP%:5601  -E 'name=Api-Metric-Beat' -E 'output.logstash.enabled=false' -E 'output.elasticsearch.hosts=[\"http://%ELK_STACK_IP%:9200\"]'"