commands:
  1_command:
    command: "curl -L -O https://artifacts.elastic.co/downloads/beats/metricbeat/metricbeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  2_command:
    command: "sudo dpkg -i metricbeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  3_command:
    command: "metricbeat modules enable apache nginx system; systemctl start metricbeat; systemctl enable metricbeat"
  4_command:
    command: "metricbeat setup --dashboards; metricbeat -E 'name=Api-Metric-Beat' -E 'output.logstash.enabled=false' -E 'output.elasticsearch.hosts=[\"http://%ELK_STACK_IP%:9200\"]'"