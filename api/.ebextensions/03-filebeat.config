files:
  "/etc/filebeat/filebeat.yml":
    mode: "000755"
    owner: root
    group: root
    content: |
      filebeat.inputs:
      - type: log
        paths:
          - /var/log/*.log
          - /var/app/current/logs/*.log
      output.elasticsearch:
        hosts: ["%ELK_STACK_IP%:9200"]

commands:
  1_command:
    command: "curl -L -O https://artifacts.elastic.co/downloads/beats/filebeat/filebeat-7.8.0-x86_64.rpm"
    cwd: /home/ec2-user
  2_command:
    command: "rpm -ivh --replacepkgs filebeat-7.8.0-x86_64.rpm"
    cwd: /home/ec2-user
  3_command:
    command: "/etc/init.d/filebeat start"
  # 4_command:
  #   command: "filebeat setup --index-management --modules system,mysql -E output.logstash.enabled=false -E 'output.elasticsearch.hosts=[\"%ELK_STACK_IP%:9200\"]'"

