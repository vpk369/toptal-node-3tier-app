commands:
  1_command:
    command: "curl -L -O https://artifacts.elastic.co/downloads/beats/metricbeat/metricbeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  2_command:
    command: "sudo dpkg -i metricbeat-oss-7.8.0-amd64.deb"
    cwd: /home/ec2-user
  3_command:
    command: "systemctl start metricbeat; systemctl enable metricbeat"